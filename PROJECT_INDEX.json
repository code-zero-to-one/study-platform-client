      "@sentry/nextjs": "^10 에러 모니터링",
      "@tosspayments/tosspayments-sdk": "결제",
      "canvas-confetti": "^1.9 완주 모달 효과",
      "date-fns": "날짜 처리",
      "dayjs": "날짜 처리",
      "@tiptap/react": "^3 리치 텍스트 에디터",
