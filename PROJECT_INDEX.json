      "central": "src/utils/error-handler.ts",
      "queryClient": "src/config/query-client.ts",
      "sentry": "src/config/sentry.ts",
      "globalError": "src/app/global-error.tsx",
      "errorPages": [
        "src/app/(service)/error.tsx",
        "src/app/(landing)/error.tsx",
        "src/app/(admin)/error.tsx"
      ]
    }
