      "@tanstack/react-query": "서버 상태 관리",
      "zustand": "전역 클라이언트 상태",
      "axios": "^1.9 HTTP 클라이언트",
      "react-hook-form": "폼 상태",
      "zod": "런타임 유효성 검증",
