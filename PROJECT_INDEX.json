      "clsx": "조건부 className",
      "tailwind-merge": "Tailwind 병합"
    }
  },
  "conventions": {
    "className": "cn() 사용 필수, 템플릿 리터럴 금지",
    "tailwind": "임의값(p-[4px]) 금지, global.css 토큰만 사용",
    "api": "openapi/ 수정 금지, 없는 엔드포인트 임의 생성 금지",
    "error": "alert() 금지, useToastStore 사용",
    "commit": "feat/fix/refactor/style/docs/test/chore : <한국어 요약>",
    "branch": "Feature → develop (staging) → main (production)"
  },
  "env": {
    "required": [
      "NEXT_PUBLIC_API_BASE_URL",
      "NEXT_PUBLIC_KAKAO_CLIENT_ID",
      "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
      "NEXT_PUBLIC_TOSS_CLIENT_KEY"
    ],
    "optional": [
      "NEXT_PUBLIC_SENTRY_DSN",
      "NEXT_PUBLIC_CLARITY_PROJECT_ID",
      "NEXT_PUBLIC_GTM_ID",
      "SENTRY_ORG",
      "SENTRY_PROJECT",
      "SENTRY_AUTH_TOKEN"
    ]
  },
  "scripts": {
    "dev": "yarn dev (Turbopack)",
    "build": "yarn build",
    "typecheck": "yarn typecheck (tsc --noEmit)",
    "lint": "yarn lint:fix",
    "storybook": "yarn storybook (port 6006)",
    "generateApi": "yarn generate:api <swagger-api-name>"
  }
